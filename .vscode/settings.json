{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never",
    "source.fixAll.oxc": "always"
  },

  "eslint.enable": false,
  "eslint.validate": []
}
