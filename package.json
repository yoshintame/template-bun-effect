{
  "name": "template-bun-effect",
  "private": true,
  "module": "src/main.ts",
  "type": "module",
  "version": "0.0.1",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json && bun run diagnostics",
    "diagnostics": "effect-language-service diagnostics --project tsconfig.json --strict",
    "depscheck": "knip"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@effect/platform-bun": "^0.90.0",
    "effect": "^3.21.3"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.2",
    "@effect/vitest": "0.29.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/node": "25.9.2",
    "@yoshintame/ox-config": "0.2.0",
    "knip": "6.16.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
